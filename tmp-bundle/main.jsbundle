    _getYearNineStar(yearInGanZhi) {
      var indexExact = LunarUtil.getJiaZiIndex(yearInGanZhi) + 1;
      var index = LunarUtil.getJiaZiIndex(this.getYearInGanZhi()) + 1;
      var yearOffset = indexExact - index;
      if (yearOffset > 1) {
        yearOffset -= 60;
      } else if (yearOffset < -1) {
        yearOffset += 60;
      }
      var yuan = Math.floor((this._year + yearOffset + 2696) / 60) % 3;
      var offset = (62 + yuan * 3 - indexExact) % 9;
      if (0 === offset) {
        offset = 9;
      }
      return NineStar.fromIndex(offset - 1);
    }
    getYearNineStar(sect = 2) {
      switch (sect) {
        case 1:
          return this._getYearNineStar(this.getYearInGanZhi());
        case 3:
          return this._getYearNineStar(this.getYearInGanZhiExact());
      }
      return this._getYearNineStar(this.getYearInGanZhiByLiChun());
    }
    getMonthNineStar(sect = 2) {
      var yearZhiIndex = this._yearZhiIndexByLiChun;
      var monthZhiIndex = this._monthZhiIndex;
      switch (sect) {
        case 1:
          yearZhiIndex = this._yearZhiIndex;
          monthZhiIndex = this._monthZhiIndex;
          break;
        case 3:
          yearZhiIndex = this._yearZhiIndexExact;
          monthZhiIndex = this._monthZhiIndexExact;
          break;
      }
      var n = 27 - yearZhiIndex % 3 * 3;
      if (monthZhiIndex < LunarUtil.BASE_MONTH_ZHI_INDEX) {
        n -= 3;
      }
      return NineStar.fromIndex((n - monthZhiIndex) % 9);
    }
    getJieQiSolar(name) {

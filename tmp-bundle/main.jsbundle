      var jq = this.getJieQiSolar(I18n.getMessage("jq.qingMing"));
      var solarYmd = this._solar.toYmd();
      if (solarYmd === jq.next(-1).toYmd()) {
        l.push("\u5BD2\u98DF\u8282");
      }
      jq = this.getJieQiSolar(I18n.getMessage("jq.liChun"));
      var offset = 4 - jq.getLunar().getDayGanIndex();

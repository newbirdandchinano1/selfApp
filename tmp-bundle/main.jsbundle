    checkLang() {
      var lang = I18n.getLanguage();
      if (this._lang != lang) {
        for (var i = 0, j = LunarUtil.JIE_QI_IN_USE.length; i < j; i++) {
          var newKey = LunarUtil.JIE_QI_IN_USE[i];
          var oldKey = this._jieQiList[i];
          var value = this._jieQi[oldKey];
          this._jieQiList[i] = newKey;
          this._jieQi[newKey] = value;
        }
        this._lang = lang;
      }
    }
    getJie() {
      for (var i = 0, j = LunarUtil.JIE_QI_IN_USE.length; i < j; i += 2) {
        var key = LunarUtil.JIE_QI_IN_USE[i];
        var d = this.getJieQiSolar(key);
        if (d && d.getYear() === this._solar.getYear() && d.getMonth() === this._solar.getMonth() && d.getDay() === this._solar.getDay()) {
          return Lunar._convertJieQi(key);
        }
      }
      return "";
    }
    getQi() {
      for (var i = 1, j = LunarUtil.JIE_QI_IN_USE.length; i < j; i += 2) {
        var key = LunarUtil.JIE_QI_IN_USE[i];
        var d = this.getJieQiSolar(key);
        if (d && d.getYear() === this._solar.getYear() && d.getMonth() === this._solar.getMonth() && d.getDay() === this._solar.getDay()) {
          return Lunar._convertJieQi(key);
        }

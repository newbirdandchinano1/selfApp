      var zhi = LunarUtil.ZHI[(this._index + LunarUtil.BASE_MONTH_ZHI_INDEX) % 12 + 1];
      return gan + zhi;
    }
    getXun() {
      return LunarUtil.getXun(this.getGanZhi());

# 复制本文件为 `.env.local` 并填入值（`.env` / `.env.local` 已在 .gitignore，勿提交 Token）。
# 更换 Token 后需重启 `npx expo start`。
#
# 你曾在聊天中泄露过旧 Token，请到 GitHub 撤销旧 PAT，再在此处填写新生成的 Token。

EXPO_PUBLIC_GITHUB_TOKEN=
EXPO_PUBLIC_GITHUB_OWNER=newbirdandchinano1
EXPO_PUBLIC_GITHUB_REPO=APP-data
EXPO_PUBLIC_GITHUB_BACKUP_PATH=backups/user_data.json
# 个人页「全量备份」多文件写入的根路径（其下自动建 sqlite/、kv/、manifest.json）
# EXPO_PUBLIC_GITHUB_BACKUP_ROOT=backups/selfapp

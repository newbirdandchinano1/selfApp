{
  "name": "myfirstapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node scripts/patch-expo-widgets.mjs",
    "start": "node -r ./scripts/patch-fs.js ./node_modules/expo/bin/cli start",
    "start:clean": "node -r ./scripts/patch-fs.js ./node_modules/expo/bin/cli start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node -r ./scripts/patch-fs.js ./node_modules/expo/bin/cli start --web",
    "lint": "expo lint",
    "test:strong-reminder": "node --experimental-strip-types scripts/test-notification-strong-reminder.mjs",
    "test:health-intake-reminder": "node --experimental-strip-types scripts/test-health-intake-reminder.mjs",
    "test:finance-reminder": "node --experimental-strip-types scripts/test-finance-reminder-logic.mjs",
    "test:task-reminder": "node --experimental-strip-types scripts/test-task-reminder-schedule.mjs",
    "test:frog-schedule-glance": "node --experimental-strip-types scripts/test-frog-schedule-glance.mjs",
    "test:schedule-placement-interval": "npx --yes tsx scripts/test-schedule-placement-interval.mjs",
    "test:schedule-minutes-backfill": "npx --yes tsx scripts/test-schedule-minutes-backfill.mjs",
    "test:schedule-placement-api-minutes": "npx --yes tsx scripts/test-schedule-placement-api-minutes.mjs",
    "test:schedule-timeline-layout": "npx --yes tsx scripts/test-schedule-timeline-layout.mjs",
    "test:schedule-timed-placement": "npx --yes tsx scripts/test-schedule-timed-placement.mjs",
    "test:schedule-axis-remap-minutes": "npx --yes tsx scripts/test-schedule-axis-remap-minutes.mjs",
    "test:schedule-reminder-minutes": "npx --yes tsx scripts/test-schedule-reminder-minutes.mjs",
    "test:habits-today-glance": "node --experimental-strip-types scripts/test-habits-today-glance.mjs",
    "test:health-intake-glance": "node --experimental-strip-types scripts/test-health-intake-glance.mjs",
    "test:finance-glance": "node --experimental-strip-types scripts/test-finance-glance.mjs",
    "test:urgency-glance": "node --experimental-strip-types scripts/test-urgency-glance.mjs",
    "test:notification-inbox": "node --experimental-strip-types scripts/test-notification-inbox.mjs",
    "test:finance-page-load": "node scripts/test-finance-page-load-fix.mjs",
    "test:sync-phase5-ui": "node scripts/test-sync-phase5-ui.mjs",
    "test:sync-phase8-apply": "node --experimental-strip-types scripts/test-sync-phase8-apply.ts",
    "test:sync-phase8-invariants": "node scripts/test-sync-phase8-invariants.mjs",
    "test:sync-phase8": "npm run test:sync-phase8-apply && npm run test:sync-phase8-invariants && npm run test:sync-phase5-ui",
    "test:finance-balance-correction": "node scripts/test-finance-balance-correction.mjs",
    "test:finance-scheduled-withholding": "node scripts/test-finance-scheduled-withholding.mjs",
    "test:memo-richdoc": "npx --yes tsx scripts/test-memo-richdoc.ts",
    "test:memo-richdoc-phase5": "npx --yes tsx scripts/test-memo-richdoc.ts"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-sc": "^0.4.4",
    "@expo-google-fonts/noto-serif-sc": "^0.4.4",
    "@expo-google-fonts/roboto-mono": "^0.4.2",
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-widgets": "~58.0.27",
    "lunar-typescript": "^1.8.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zheng-background": "file:modules/zheng-background",
    "zheng-vision-cutout": "file:modules/zheng-vision-cutout"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "graceful-fs": "^4.2.11",
    "typescript": "~6.0.3"
  },
  "private": true
}

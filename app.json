{
  "expo": {
    "name": "小郑的自我修养",
    "slug": "xiaozheng-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zheng",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.myselfManage.appdemo",
      "infoPlist": {
        "CFBundleDisplayName": "小郑的自我修养",
        "CFBundleName": "小郑的自我修养",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ],
      "package": "com.myselfManage.appdemo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/start.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "enableFullScreenImage_legacy": true,
          "dark": {
            "image": "./assets/images/start.png",
            "resizeMode": "cover",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "用于从相册选择照片：记录饮食、添加衣橱单品等。",
          "cameraPermission": "用于拍照：记录饮食、添加衣橱单品等。"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/strong_reminder.wav"
          ],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-zheng-app-intents",
      "expo-font",
      "expo-audio",
      "expo-asset",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.myselfManage.appdemo.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.myselfManage.appdemo",
          "enableAndroid": false,
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "FrogScheduleWidget",
              "displayName": "今日青蛙",
              "description": "下一只青蛙与当前入格倒计时",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "./widgets/FrogScheduleWidget.tsx"
              }
            },
            {
              "name": "HabitsTodayWidget",
              "displayName": "今日习惯",
              "description": "小习惯今日进度与未完成清单",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "./widgets/HabitsTodayWidget.tsx"
              }
            },
            {
              "name": "HealthIntakeWidget",
              "displayName": "健康摄入",
              "description": "关注项进度环与下次摄入提醒",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "./widgets/HealthIntakeWidget.tsx"
              }
            },
            {
              "name": "FinanceGlanceWidget",
              "displayName": "财务一眼",
              "description": "今日已花、预算剩余与下一笔定时支出",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "./widgets/FinanceGlanceWidget.tsx"
              }
            },
            {
              "name": "UrgencyWidget",
              "displayName": "紧急度",
              "description": "逾期、今日截止与临期项目计数",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "./widgets/UrgencyWidget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ea1d48f-be0b-461b-b389-9e45a3b94814"
      }
    }
  }
}
